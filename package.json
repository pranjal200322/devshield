{
  "name": "devshield",
  "version": "1.0.0",
  "description": "API rate limiting and caching service built with Node.js, Express and Redis",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --coverage --runInBand --forceExit"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  }
}
